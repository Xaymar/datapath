# CMake package for an installed DataPath:
#   find_package(datapath 1 CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE datapath::datapath)
# DATAPATH_SHARED_LIBRARY tells whether this install is the shared or the static library.

@PACKAGE_INIT@

set(DATAPATH_SHARED_LIBRARY @DATAPATH_SHARED@)

include(CMakeFindDependencyMacro)
if(NOT WIN32 AND NOT DATAPATH_SHARED_LIBRARY)
	# The static library carries its thread dependency to whoever links it.
	set(THREADS_PREFER_PTHREAD_FLAG ON)
	find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/datapath-targets.cmake")
check_required_components(datapath)
